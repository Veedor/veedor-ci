{
  "name": "@veedor/ci",
  "version": "0.1.0",
  "description": "Find the tests wasting your CI minutes — and see the bill they generate.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "veedor-ci": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/action",
    "!dist/action.*",
    "!dist/action-entry.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && npm run build:action",
    "build:action": "esbuild src/action-entry.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/action/index.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/rest": "^22.0.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
